# ExplorePune — environment variables
# Copy this file to `.env.local` and fill in the values.
#
# On Vercel these are set per-environment in Project Settings → Environment
# Variables. See DEPLOYMENT.md for which ones each environment needs.

# --- Google Maps (required for the map view + detail maps) ---------------
# Create a key in Google Cloud Console with the "Maps JavaScript API" enabled
# and billing turned on. Restrict it by HTTP referrer for safety — include your
# production domain *and* `*.vercel.app` if you want maps in preview deploys.
# The map degrades to a friendly placeholder when this is empty.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID enables Google's vector maps + Advanced Markers styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Admin dashboard gate -------------------------------------------------
# Passphrase required to open /admin and approve/reject community submissions.
# There are no user accounts; this is a lightweight gate, not real auth.
ADMIN_PASSPHRASE=change-me

# --- Site ----------------------------------------------------------------
# Public base URL, used for metadata, Open Graph and the sitemap. Leave this
# empty on Vercel and the app falls back to the domain Vercel assigns.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storage (production) -------------------------------------------------
# Reviews, place requests and view counts live in a JSON document in Redis.
# Connect a Redis store (Vercel dashboard → Storage) and these are injected
# automatically. Leave them empty locally: the app falls back to `data/db.json`
# on disk, so `next dev` needs no cloud account. Upstash's own
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN names work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Community photo uploads. Connect a Blob store and this is injected
# automatically. Empty locally means uploads are written to /public/uploads.
BLOB_READ_WRITE_TOKEN=
